# .env.example — production environment variables (template)
# Copy this file to .env and fill in secure values. Do NOT commit your real .env.

# Core
DJANGO_SETTINGS_MODULE=Connect.settings.production
SECRET_KEY=replace-with-your-secret-key
SITE_URL=https://example.com
ALLOWED_HOSTS=example.com,www.example.com

# Database — prefer DATABASE_URL in production. Example format (replace placeholders):
# DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
# Uncomment and set DATABASE_URL or set POSTGRES_* variables if using the included postgres service.
# DATABASE_URL=postgresql://postgres:your_password@postgres:5432/devlink_db
POSTGRES_DB=devlink_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>

# Redis (used for channels and Celery broker/result backend)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Email (fill with your SMTP provider credentials)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=postmaster@example.com
EMAIL_HOST_PASSWORD=<EMAIL_HOST_PASSWORD>
DEFAULT_FROM_EMAIL=noreply@example.com

# Other production toggles
DEBUG=False

# Notes:
# - Replace placeholders with secure secrets or use a secrets manager.
# - Do NOT store this file with real credentials in version control.
# - When deploying, create an actual .env from this template and protect it.
